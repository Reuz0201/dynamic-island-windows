<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows-TFM нужен для WinRT API (медиа, Bluetooth, питание) -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>DynamicIsland</AssemblyName>
    <RootNamespace>DynamicIsland</RootNamespace>
    <!-- запустится и на .NET 9/10, если 8-го рантайма нет -->
    <RollForward>Major</RollForward>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Локальная сборка = dev (без автообновлений). GitHub Actions подставляет настоящую версию. -->
    <Version>0.0.0-dev</Version>
    <Product>Dynamic Island</Product>

    <!-- в этих папках отдельные проекты: настройки и помощник трафика -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Settings\**;NetHelper\**;docs\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- громкость и смена устройства вывода звука -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <!-- яркость экрана ноутбука (WMI) -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
