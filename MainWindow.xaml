<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island"
        Width="600" Height="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <StackPanel x:Name="IslandRow" Orientation="Horizontal"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0">

            <!-- ============================ ОСТРОВ ============================ -->
            <Grid x:Name="IslandHost" VerticalAlignment="Top"
                  Width="120" Height="30" RenderTransformOrigin="0.5,0">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="IslandScale" ScaleX="1" ScaleY="1"/>
                </Grid.RenderTransform>

                <!-- Свечение цветом обложки / алерта -->
                <Border x:Name="Glow" CornerRadius="20" Opacity="0" IsHitTestVisible="False" Margin="6,4">
                    <Border.Background>
                        <SolidColorBrush x:Name="GlowBrush" Color="#7A5CFF"/>
                    </Border.Background>
                    <Border.Effect>
                        <BlurEffect Radius="28" RenderingBias="Performance"/>
                    </Border.Effect>
                </Border>

                <Border x:Name="Island" CornerRadius="15" Background="#F2000000"
                        BorderThickness="1" BorderBrush="#14FFFFFF" ClipToBounds="True">
                    <Grid>

                        <!-- ===== Ничего нет ===== -->
                        <StackPanel x:Name="Idle" Orientation="Horizontal"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0">
                            <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="12" Foreground="#80FFFFFF" VerticalAlignment="Center"/>
                            <TextBlock x:Name="IdleLabel" Text="Тишина" Margin="8,0,0,0" FontSize="12"
                                       Foreground="#80FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- ===== Компакт: музыка ===== -->
                        <Grid x:Name="Compact" Margin="6,0,12,0" Opacity="0" IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Width="24" Height="24" VerticalAlignment="Center">
                                <Ellipse>
                                    <Ellipse.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#7A5CFF" Offset="0"/>
                                            <GradientStop Color="#FF5CA8" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Ellipse x:Name="CompactArt"/>
                            </Grid>

                            <TextBlock x:Name="CompactTitle" Grid.Column="1" Margin="10,0,10,0"
                                       VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                       Foreground="White" TextTrimming="CharacterEllipsis"/>

                            <StackPanel x:Name="EqCompact" Grid.Column="2" Orientation="Horizontal"
                                        VerticalAlignment="Center" Height="12"/>
                        </Grid>

                        <!-- ===== Компакт: активность (таймер, загрузка...) ===== -->
                        <Grid x:Name="CompactActivity" Margin="12,0,14,0" Opacity="0" IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="CompactActGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="14" VerticalAlignment="Center" Foreground="White"/>
                            <TextBlock x:Name="CompactActTitle" Grid.Column="1" Margin="10,0,10,0"
                                       VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                       Foreground="White" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="CompactActBadge" Grid.Column="2" VerticalAlignment="Center"
                                       FontSize="13" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/>
                        </Grid>

                        <!-- значки-статусы (щит VPN и т.п.) -->
                        <StackPanel x:Name="StatusPanel" Orientation="Horizontal"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>

                        <!-- ===== Раскрытый вид ===== -->
                        <StackPanel x:Name="Expanded" Margin="16,14,16,12" Opacity="0"
                                    IsHitTestVisible="False" VerticalAlignment="Top">

                            <!-- музыка -->
                            <StackPanel x:Name="MusicCard">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Width="72" Height="72">
                                        <Border CornerRadius="14">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#7A5CFF" Offset="0"/>
                                                    <GradientStop Color="#FF5CA8" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="26" Foreground="#CCFFFFFF"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border x:Name="ExpandedArt" CornerRadius="14"/>
                                    </Grid>

                                    <StackPanel Grid.Column="1" Margin="14,2,8,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="ExpandedTitle" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="White" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="ExpandedArtist" FontSize="13" Margin="0,2,0,0"
                                                   Foreground="#B3FFFFFF" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="ExpandedApp" FontSize="11" Margin="0,6,0,0"
                                                   Foreground="#66FFFFFF" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <StackPanel x:Name="EqExpanded" Grid.Column="2" Orientation="Horizontal"
                                                VerticalAlignment="Top" Margin="0,6,2,0" Height="16"/>
                                </Grid>

                                <Grid x:Name="ProgressRow" Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="TimeNow" FontSize="11" Foreground="#99FFFFFF"
                                               VerticalAlignment="Center" Text="0:00"
                                               Typography.NumeralAlignment="Tabular"/>

                                    <Grid x:Name="ProgressTrack" Grid.Column="1" Height="14" Background="Transparent"
                                          Cursor="Hand" VerticalAlignment="Center"
                                          MouseLeftButtonDown="Progress_MouseDown">
                                        <Border Height="4" CornerRadius="2" Background="#33FFFFFF" VerticalAlignment="Center"/>
                                        <Border x:Name="ProgressFill" Height="4" CornerRadius="2" Width="0"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Background>
                                                <SolidColorBrush x:Name="ProgressBrush" Color="White"/>
                                            </Border.Background>
                                        </Border>
                                    </Grid>

                                    <TextBlock x:Name="TimeTotal" Grid.Column="2" FontSize="11" Foreground="#99FFFFFF"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" Text="0:00"
                                               Typography.NumeralAlignment="Tabular"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                    <Button x:Name="PrevButton" Style="{StaticResource IslandButton}"
                                            Content="&#xE892;" Click="Prev_Click" Focusable="False"/>
                                    <Button x:Name="PlayButton" Style="{StaticResource IslandButton}"
                                            Content="&#xE768;" FontSize="20" Width="44" Height="44" Margin="14,0"
                                            Click="Play_Click" Focusable="False"/>
                                    <Button x:Name="NextButton" Style="{StaticResource IslandButton}"
                                            Content="&#xE893;" Click="Next_Click" Focusable="False"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock x:Name="NothingPlaying" Text="Ничего не играет" FontSize="13"
                                       Foreground="#80FFFFFF" Margin="2,2,0,0"/>

                            <!-- живые активности -->
                            <StackPanel x:Name="RowsPanel"/>

                            <!-- быстрые действия -->
                            <Grid x:Name="ToolsRow" Margin="0,14,0,0">
                                <StackPanel x:Name="ToolsButtons" Orientation="Horizontal" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ToolsStatus" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           FontSize="11.5" Foreground="#80FFFFFF" TextTrimming="CharacterEllipsis"
                                           MaxWidth="170"/>
                            </Grid>
                        </StackPanel>

                        <!-- ===== Алерт ===== -->
                        <ContentControl x:Name="AlertHost" Margin="10,10,14,10" Opacity="0"
                                        IsHitTestVisible="False" VerticalAlignment="Top" Focusable="False"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============================ ВТОРОЙ КРУЖОК (Split Island) ============================ -->
            <Grid x:Name="BubbleHost" Margin="8,0,0,0" VerticalAlignment="Top"
                  Visibility="Collapsed" RenderTransformOrigin="0,0.5" Opacity="0">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="BubbleScale" ScaleX="0.6" ScaleY="0.6"/>
                </Grid.RenderTransform>
                <Border x:Name="BubbleBorder" Height="36" MinWidth="36" CornerRadius="18" Background="#F2000000"
                        BorderThickness="1" BorderBrush="#14FFFFFF" Padding="11,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="BubbleGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock x:Name="BubbleText" Margin="6,0,0,0" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
