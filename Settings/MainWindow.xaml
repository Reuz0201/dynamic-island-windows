<Window x:Class="DynamicIsland.SettingsApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island — настройки"
        Width="940" Height="680" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#0E0E10"
        Foreground="White"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ меню слева ============ -->
        <Border Background="#141416" BorderBrush="#14FFFFFF" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,18,14,14">
                <StackPanel DockPanel.Dock="Top" Margin="8,0,0,18">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="14" CornerRadius="7" Background="Black"
                                BorderBrush="#33FFFFFF" BorderThickness="1" VerticalAlignment="Center"/>
                        <TextBlock Text="Dynamic Island" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="VersionText" FontSize="12" Foreground="#80FFFFFF" Margin="0,6,0,0"/>
                </StackPanel>

                <TextBlock x:Name="SavedHint" DockPanel.Dock="Bottom" FontSize="12" Foreground="#30D158"
                           Margin="8,0,0,0" Opacity="0" Text="Сохранено ✓"/>

                <StackPanel x:Name="NavPanel"/>
            </DockPanel>
        </Border>

        <!-- ============ справа: превью + страница ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- превью острова -->
            <Border Margin="24,20,24,8" CornerRadius="16" Height="150" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2A1B4D" Offset="0"/>
                        <GradientStop Color="#1B2D4D" Offset="0.55"/>
                        <GradientStop Color="#3D1B33" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <TextBlock Text="превью" FontSize="11" Foreground="#66FFFFFF" Margin="14,10,0,0"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                        <!-- компакт с музыкой -->
                        <Grid x:Name="PreviewHost">
                            <Border x:Name="PreviewGlow" Margin="6,4" CornerRadius="18">
                                <Border.Background>
                                    <SolidColorBrush x:Name="PreviewGlowBrush" Color="#FF5CA8"/>
                                </Border.Background>
                                <Border.Effect>
                                    <BlurEffect Radius="26"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="PreviewIsland" Height="36" CornerRadius="18" Padding="6,0,12,0"
                                    Background="#F2000000" BorderBrush="#14FFFFFF" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="24" Height="24">
                                        <Ellipse.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#FF9F0A" Offset="0"/>
                                                <GradientStop Color="#FF5CA8" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock x:Name="PreviewTitle" Text="Мой трек · Артист" Margin="10,0,10,0"
                                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <StackPanel x:Name="PreviewEq" Orientation="Horizontal" Height="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- «ничего не играет» -->
                        <Grid Margin="36,0,0,0" VerticalAlignment="Center">
                            <Border x:Name="PreviewIdle" Height="30" CornerRadius="15" Padding="14,0"
                                    Background="#F2000000" BorderBrush="#14FFFFFF" BorderThickness="1">
                                <StackPanel x:Name="PreviewIdleContent" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="12"
                                               Foreground="#80FFFFFF" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PreviewIdleText" Text="Тишина" Margin="8,0,0,0" FontSize="12"
                                               Foreground="#80FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="24,8,16,24">
                <ContentControl x:Name="PageHost" Focusable="False"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
